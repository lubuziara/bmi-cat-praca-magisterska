# JEDYNY aktywny plik konfiguracji: bmi-cat/.env
# Nie dodawaj tego pliku do Git ani do zasobów Fluttera.

# ADRESY APLIKACJI
BMI_API_BASE_URL=http://localhost:8000
BMI_ANDROID_API_BASE_URL=http://10.0.2.2:8000
BMI_FRONTEND_URL=http://localhost:5173
BMI_CORS_ORIGINS=["http://localhost:5173"]

# GOOGLE — logowanie OAuth, a nie klucz Google Maps/Gemini.
# Wklej Client ID typu WEB. Android również używa go jako serverClientId.
# Client secret nie jest potrzebny w obecnym sposobie logowania.
BMI_GOOGLE_CLIENT_ID=

# BAZA DANYCH — ścieżka względna liczona od katalogu backend.
BMI_DATABASE_URL=sqlite:///./bmi_cat.db
BMI_SESSION_SECONDS=3600
BMI_RESET_SECONDS=1800

# POCZTA — local zapisuje pliki .eml; smtp wysyła prawdziwe wiadomości.
BMI_MAIL_MODE=local
BMI_OUTBOX_DIR=outbox
BMI_SMTP_HOST=
BMI_SMTP_PORT=587
BMI_SMTP_USER=
BMI_SMTP_PASSWORD=
BMI_MAIL_FROM=noreply@example.com

# Klucze kolejnych usług dodamy tutaj wraz z ich integracją.
# Do Fluttera przekazywane są WYŁĄCZNIE adres API i publiczny Google Client ID.

# SMS — wyłącznie tryb testowy; wiadomości zapisane lokalnie.
BMI_SMS_OUTBOX_DIR=sms_outbox

# Kalendarz OAuth (sekrety tylko dla backendu)
BMI_GOOGLE_CALENDAR_CLIENT_ID=
BMI_GOOGLE_CALENDAR_CLIENT_SECRET=
BMI_OUTLOOK_CLIENT_ID=
BMI_OUTLOOK_CLIENT_SECRET=
BMI_CALENDAR_TOKEN_KEY=
